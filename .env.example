# Lean edge Memory MCP host env (copy to .env — never commit secrets).
# dual_write OFF · not Memory GA · MEMORY_MCP_* / PALACE_ROOT / MEMORY_TENANT only.

# Palace filesystem root (tenant subdirs under this path)
PALACE_ROOT=./data/memory-palaces

# Process tenant label (validated if set). Tool calls must pass tenant;
# omit fail-closes and does not write PALACE_ROOT/default.
MEMORY_TENANT=default

# Empty = stdio (TUI / Claude Desktop style). e.g. :8080 for streamable HTTP
# :port is forced to 127.0.0.1 unless MEMORY_MCP_HTTP_ALLOW_NON_LOOPBACK is true.
MEMORY_MCP_HTTP_ADDR=
# MEMORY_MCP_HTTP_ADDR=:8080

# MCP mount path when HTTP mode is enabled (healthz always at /healthz)
MEMORY_MCP_HTTP_PATH=/mcp

# Required to bind 0.0.0.0 / :: / non-loopback. Leave unset for local loopback default.
# MEMORY_MCP_HTTP_ALLOW_NON_LOOPBACK=

# Optional shared secret for streamable HTTP MCP (not /healthz). Empty = off.
# Send X-Memory-MCP-Secret or Authorization: Bearer. Do not commit a value.
# MEMORY_MCP_HTTP_SECRET=

# Optional: persist ONNX vectors on palace JSON. Default off (unset).
# ONNX only — ignored on hash (never persist hash). Does not require Qdrant/usearch.
# MEMORY_PERSIST_EMBEDDINGS=

# No GitHub token is required. Host + kernel are public.
# Do not invent a token requirement for compose / go install / CI.
