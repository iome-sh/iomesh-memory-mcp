# Lean edge Memory MCP host env (copy to .env — never commit secrets).
# dual_write OFF · not Memory GA · prefer MEMORY_MCP_* over AION_MEMORY_MCP_*

# Palace filesystem root (tenant subdirs under this path)
PALACE_ROOT=./data/memory-palaces

# Default tenant subdirectory when tool input omits tenant
MEMORY_TENANT=default

# Empty = stdio (TUI / Claude Desktop style). e.g. :8080 for streamable HTTP
MEMORY_MCP_HTTP_ADDR=
# MEMORY_MCP_HTTP_ADDR=:8080

# MCP mount path when HTTP mode is enabled (healthz always at /healthz)
MEMORY_MCP_HTTP_PATH=/mcp

# Deprecated aliases (one-time deprecation log if set without preferred key):
# AION_MEMORY_MCP_HTTP_ADDR
# AION_MEMORY_MCP_HTTP_PATH
# AION_PALACE_ROOT

# Docker build only (private kernel while still private):
# GH_TOKEN=
